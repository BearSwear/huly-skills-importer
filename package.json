{
  "name": "huly-skills-importer",
  "version": "0.1.0",
  "description": "Community CLI for discovering and importing Recruiting skills into Huly workspaces.",
  "type": "module",
  "license": "MIT",
  "author": "huly-skills-importer contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/BearSwear/huly-skills-importer.git"
  },
  "homepage": "https://github.com/BearSwear/huly-skills-importer#readme",
  "bugs": {
    "url": "https://github.com/BearSwear/huly-skills-importer/issues"
  },
  "keywords": [
    "huly",
    "recruiting",
    "skills",
    "importer",
    "ats",
    "hr",
    "cli"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "huly-skills-importer": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills/example.yaml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "discover": "tsx src/index.ts discover",
    "import:dry": "tsx src/index.ts import skills/startup-platform.yaml --dry-run",
    "import": "tsx src/index.ts import skills/startup-platform.yaml",
    "catalog:check": "tsx src/index.ts check skills/startup-platform.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@hcengineering/api-client": "^0.7.19",
    "@hcengineering/core": "^0.7.26",
    "@hcengineering/recruit": "^0.7.0",
    "@hcengineering/tags": "^0.7.0",
    "@hcengineering/ui": "^0.7.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
