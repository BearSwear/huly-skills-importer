{
  "name": "huly-skills-importer",
  "version": "0.4.0",
  "description": "Community CLI for materializing and inspecting controlled Huly Recruiting skill taxonomies.",
  "type": "module",
  "license": "MIT",
  "author": "BearSwear and huly-skills-importer contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/BearSwear/huly-skills-importer.git"
  },
  "homepage": "https://github.com/BearSwear/huly-skills-importer#readme",
  "bugs": {
    "url": "https://github.com/BearSwear/huly-skills-importer/issues"
  },
  "keywords": [
    "huly",
    "recruiting",
    "skills",
    "taxonomy",
    "importer",
    "rekoni",
    "ats",
    "hr",
    "cli",
    "industry"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "huly-skills-importer": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills/import-skills.yaml",
    "skills/example.yaml",
    "skills/CATALOG.md",
    "skills/industries",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "discover": "tsx src/index.ts discover",
    "suggestions": "tsx src/index.ts suggestions",
    "inspect": "tsx src/index.ts inspect",
    "import:dry": "tsx src/index.ts import skills/import-skills.yaml --dry-run",
    "import": "tsx src/index.ts import skills/import-skills.yaml",
    "catalog:check": "tsx src/index.ts check skills/import-skills.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "catalogues": "tsx src/index.ts catalogues"
  },
  "dependencies": {
    "@hcengineering/api-client": "0.7.423",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
