# Huly instance base URL, without a trailing slash.
HULY_URL=https://huly.example.com

# Workspace slug from /workbench/<workspace-slug>.
HULY_WORKSPACE=my-workspace

# Preferred authentication method when you already have a token.
HULY_TOKEN=

# Alternative authentication method supported by the Huly API client.
# Leave empty when HULY_TOKEN is set.
HULY_EMAIL=
HULY_PASSWORD=

# websocket (default) or rest
HULY_TRANSPORT=websocket

# Optional GitHub Packages token for npm installation.
# The official Huly packages are published through GitHub Packages.
# A token with read:packages is sufficient for package installation.
GITHUB_PACKAGES_TOKEN=
