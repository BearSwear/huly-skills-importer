# Huly instance base URL, without a trailing slash.
HULY_URL=https://huly.example.com

# Workspace slug from /workbench/<workspace-slug>.
HULY_WORKSPACE=my-workspace

# Preferred authentication method.
HULY_TOKEN=

# Optional fallback authentication method. Leave empty when HULY_TOKEN is set.
HULY_EMAIL=
HULY_PASSWORD=

# websocket (default/tested) or rest
HULY_TRANSPORT=websocket
